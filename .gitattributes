# Normalise line endings in the working tree, LF in the repository.
* text=auto eol=lf

*.html  text diff=html
*.css   text diff=css
*.js    text
*.md    text
*.yml   text
*.txt   text
*.svg   text

# Binary assets: never diff or normalise.
*.woff2 binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
